{
  "name": "everlook",
  "version": "0.13.0",
  "description": "Desktop uploader for Everlook world data",
  "homepage": "https://everlook.ing",
  "desktopName": "dev.csfh.everlook",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:desktop": "bash scripts/test-linux-integration.sh && bash scripts/test-omarchy-installer.sh",
    "package:omarchy": "bash scripts/package-omarchy.sh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "build": "npm run typecheck && electron-vite build && node scripts/verify-build.mjs",
    "package": "npm run build && electron-builder --publish never",
    "desktop:install": "bash scripts/install-linux.sh",
    "desktop:uninstall": "bash scripts/uninstall-linux.sh",
    "test:release": "python scripts/release_artifacts_test.py && node --test scripts/package-smoke.test.mjs"
  },
  "keywords": [
    "electron",
    "world-of-warcraft",
    "everlook"
  ],
  "author": "Christoffer Hallas",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "dev.csfh.everlook",
    "productName": "Everlook",
    "copyright": "Copyright (c) 2026 Christoffer Hallas",
    "executableName": "everlook",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon-512.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "protocols": [
      {
        "name": "Everlook authorization",
        "schemes": [
          "everlook"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Christoffer Hallas <5760821+csfh@users.noreply.github.com>",
      "icon": "build/icon-512.png",
      "desktop": {
        "entry": {
          "Name": "Everlook",
          "Comment": "Desktop uploader for Everlook world data",
          "Categories": "Utility;",
          "StartupWMClass": "dev.csfh.everlook",
          "MimeType": "x-scheme-handler/everlook;",
          "Terminal": "false"
        }
      },
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Everlook-${version}-mac-${arch}.${ext}",
      "identity": null,
      "notarize": false,
      "icon": "build/icon-512.png",
      "publish": null,
      "executableName": "Everlook"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Everlook-${version}-windows-${arch}.${ext}",
      "icon": "build/icon-512.png",
      "signExecutable": false,
      "executableName": "Everlook"
    },
    "publish": {
      "provider": "generic",
      "url": "https://everlook.ing/updates"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
