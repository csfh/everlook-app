# Object storage credentials for `aws s3 cp` (GitHub Actions secrets in CI).
# Leave the key fields empty in this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Unpackaged / local updater tests. Packaged builds use the Everlook generic feed.
# EVERLOOK_UPDATE_URL=http://127.0.0.1:8765
